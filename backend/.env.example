# MongoDB Atlas connection string - yahan apni Atlas URI paste karo
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/shadihall
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/shadihall
# JWT secret - token isi se banta aur check hota hai. Apna strong secret likho,
# ye kabhi GitHub ya chat mein share mat karo.
JWT_SECRET=shadi-hall-secret-change-me
